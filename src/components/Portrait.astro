---
// Photo de profil.
import { Image } from "astro:assets";
import portrait from "../assets/valentin-portrait.jpg";

const { eager = false, class: className = "" } = Astro.props;
---

<figure class:list={["w-full max-w-sm", className]}>
  <Image
    src={portrait}
    alt="Valentin Deroo devant une vue panoramique sur une ville à la tombée de la nuit"
    width={480}
    height={640}
    loading={eager ? "eager" : "lazy"}
    class="block aspect-[3/4] h-auto w-full border-[1.5px] border-ink object-cover"
  />
</figure>
