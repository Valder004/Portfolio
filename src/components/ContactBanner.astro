---
// Appel à me contacter, en aplat orange.
import Button from "./Button.astro";

const { title = "Un club, une marque, un événement ?", text, class: className = "" } = Astro.props;
---

<section class:list={["bg-orange text-white", className]}>
  <div class="mx-auto flex max-w-7xl flex-col gap-6 px-5 py-12 md:flex-row md:items-center md:justify-between md:gap-12 md:px-8 md:py-14">
    <div>
      <h2 class="font-varsity text-[clamp(1.6rem,4vw,2.5rem)] leading-tight uppercase">{title}</h2>
      {text && <p class="mt-2 text-lg text-white/90">{text}</p>}
    </div>
    <Button href="/contact" variant="light" class="shrink-0 self-start md:self-auto">Me contacter</Button>
  </div>
</section>
