---
// Appel à me contacter, en aplat orange : le bouton est dans le but où finit le ballon.
import Button from "./Button.astro";

const { title = "Un club, une marque, un événement ?", text, class: className = "" } = Astro.props;
---

<section class:list={["relative bg-orange text-white", className]}>
  <div class="relative z-[2] mx-auto flex max-w-7xl flex-col gap-10 px-5 py-14 md:flex-row md:items-center md:justify-between md:gap-12 md:px-8 md:py-20">
    <div>
      <h2 class="jersey-ink font-varsity text-[clamp(1.6rem,4vw,2.5rem)] leading-tight uppercase">{title}</h2>
      {text && <p class="mt-2 text-lg text-white/90">{text}</p>}
    </div>
    <div data-goal class="goal relative flex h-44 w-full shrink-0 items-center justify-center md:h-48 md:w-96">
      <span aria-hidden="true" class="goal-net absolute inset-0"></span>
      <i data-play data-play-x="r" aria-hidden="true" class="absolute -top-5 left-0 md:hidden"></i>
      <i data-play data-play-goal aria-hidden="true" class="absolute top-[22%] left-[20%]"></i>
      <Button href="/contact" variant="light" class="goal-button relative">Me contacter</Button>
    </div>
  </div>
</section>
