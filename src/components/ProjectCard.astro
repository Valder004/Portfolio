---
// Carte projet : version "featured" (accueil) ou compacte (page Projets).
import { Image } from "astro:assets";

const { project, featured = false } = Astro.props;
const href = `/projets/${project.slug}`;
---

<article
  class="group flex min-w-0 flex-col overflow-hidden border border-ink/20 bg-paper-light transition duration-200 hover:-translate-y-[3px] hover:shadow-[0_8px_24px_rgb(22_22_22/0.06)] motion-reduce:transition-none motion-reduce:hover:translate-y-0"
>
  <!-- Visuel -->
  <a
    href={href}
    aria-label={`Découvrir le projet ${project.title}`}
    class:list={[
      "relative block overflow-hidden border-b border-ink/20 bg-stone",
      featured ? "aspect-[5/4]" : "aspect-[2/1]",
    ]}
  >
    <Image
      src={project.image}
      alt={project.alt}
      inferSize={typeof project.image === "string"}
      widths={[480, 800, 1200]}
      sizes="(min-width: 1280px) 25vw, (min-width: 640px) 50vw, 100vw"
      class:list={["absolute inset-0 size-full object-cover", project.slug === "montbeliard" && "scale-[1.04]"]}
    />
    <span
      class:list={[
        "absolute z-[1] grid place-items-center font-mono text-[0.55rem]",
        featured ? "top-4 right-4 size-10 bg-orange text-ink" : "top-3 right-3 size-8 bg-ink text-paper",
      ]}
    >
      {project.number}
    </span>
  </a>

  <!-- Discipline / année -->
  <div
    class:list={[
      "grid grid-cols-[1fr_auto] gap-4 font-mono leading-relaxed uppercase",
      featured ? "px-4 pt-5 text-[0.6rem] md:px-6" : "px-4 pt-3 text-[0.55rem] xl:px-3.5",
    ]}
  >
    <p>{project.discipline}</p>
    <p>{project.year}</p>
  </div>

  <!-- Contenu -->
  <div
    class:list={[
      "flex flex-1 flex-col",
      featured ? "min-h-[245px] px-4 pt-4 pb-4 md:px-6 md:pb-6" : "min-h-[185px] px-4 pt-3 pb-4 xl:px-3.5",
    ]}
  >
    <div class:list={[featured && "pb-8"]}>
      <h2
        class:list={[
          "font-display leading-[1.02] font-medium text-balance uppercase",
          featured
            ? "text-[clamp(2.25rem,3.2vw,3.3rem)] sm:min-h-[2.04em]"
            : "text-[clamp(1.75rem,4vw,2.2rem)] xl:text-[clamp(1.5rem,1.8vw,1.9rem)]",
        ]}
      >
        <a href={href}>{project.title}</a>
      </h2>
      <p class:list={["mt-3 max-w-[34rem] leading-[1.55] text-ink/80", featured ? "text-[0.9rem]" : "text-[0.85rem] xl:text-[0.8rem]"]}>
        {project.intro}
      </p>

      {
        !featured && (
          <>
            <p class="mt-3 flex flex-col gap-1 border-t border-ink/20 pt-2.5 text-[0.85rem] leading-[1.55] text-ink/80 xl:text-[0.8rem]">
              <strong class="font-mono text-[0.62rem] font-normal text-ink uppercase">Mon rôle</strong>
              {project.role}
            </p>
            <ul class="mt-3 mb-4 flex flex-wrap gap-1.5" aria-label="Livrables">
              {project.deliverables.slice(0, 2).map((deliverable) => (
                <li class="border border-ink/20 bg-paper px-2 py-1 font-mono text-[0.58rem] leading-normal uppercase">
                  {deliverable}
                </li>
              ))}
            </ul>
          </>
        )
      }
    </div>

    <a
      href={href}
      aria-label={`Découvrir le projet ${project.title}`}
      class:list={[
        "mt-auto flex items-center justify-between border-t font-mono text-[0.66rem] uppercase",
        featured ? "border-ink pt-4" : "border-ink/20 pt-2.5",
      ]}
    >
      <span>Voir le projet</span>
      <strong
        aria-hidden="true"
        class:list={[
          "grid place-items-center bg-orange font-sans font-normal transition duration-200 group-hover:rotate-45 group-hover:bg-ink group-hover:text-paper motion-reduce:transition-none",
          featured ? "size-10 text-xl" : "size-8 text-base",
        ]}>↗</strong
      >
    </a>
  </div>
</article>
