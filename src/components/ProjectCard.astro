---
// Carte projet : une feuille aimantée sur le tableau. Toute la carte est un lien vers la page du projet.
import { Image } from "astro:assets";
import PosterRotator from "./PosterRotator.astro";
import Token from "./Token.astro";
import { projectMeta } from "../lib/projects.js";

const { project, showRole = false } = Astro.props;
---

<a
  href={`/projets/${project.slug}`}
  class="pinned group relative flex min-w-0 flex-col border-[1.5px] border-ink bg-white transition-[transform,box-shadow] duration-300 ease-out hover:shadow-[7px_7px_0_var(--color-orange)]"
>
  <Token class="absolute -top-5 left-1/2 z-[1] -translate-x-1/2" />
  <i data-play data-play-x="r" aria-hidden="true" class="play-side absolute top-10 left-0"></i>
  <i data-play data-play-x="r" aria-hidden="true" class="play-side absolute bottom-2 left-0"></i>
  <div class:list={["relative aspect-[4/3] overflow-hidden border-b-[1.5px] border-ink", project.slides ? "bg-ink" : "bg-chalk"]}>
    {/* Plusieurs visuels : ils défilent automatiquement, affichés en entier */}
    {
      project.slides ? (
        <PosterRotator
          slides={project.slides}
          label={`Visuels du projet ${project.title}`}
          sizes="(min-width: 1024px) 25vw, 60vw"
          class="absolute inset-0"
          imgClass="object-contain pt-4 pb-8"
        />
      ) : (
        <Image
          src={project.image}
          alt={project.alt}
          inferSize={typeof project.image === "string"}
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          class="absolute inset-0 size-full object-contain p-[5%] transition-transform duration-500 ease-out group-hover:scale-[1.03]"
        />
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-5 md:p-6">
    <p class="text-sm text-slate">{projectMeta(project)}</p>
    <h3 class="mt-2 font-varsity text-[clamp(1.6rem,4vw,2.25rem)] leading-none uppercase group-hover:text-orange">
      {project.title}
    </h3>
    <p class="mt-3 leading-relaxed">{project.intro}</p>
    {
      showRole && (
        <p class="mt-4 text-sm leading-relaxed text-slate">
          <span class="font-semibold text-ink">Mon rôle :</span> {project.role}
        </p>
      )
    }
    <span class="mt-auto pt-5 font-semibold underline decoration-2 underline-offset-4 group-hover:text-orange">
      Voir le projet
    </span>
  </div>
</a>
