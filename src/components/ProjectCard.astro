---
// Carte projet : toute la carte est un lien vers la page du projet.
import { Image } from "astro:assets";
import PosterRotator from "./PosterRotator.astro";
import { projectMeta } from "../lib/projects.js";

const { project, showRole = false } = Astro.props;
---

<a
  href={`/projets/${project.slug}`}
  class="group flex min-w-0 flex-col border-[1.5px] border-ink bg-white transition-colors hover:border-orange"
>
  <div class:list={["relative aspect-[4/3] overflow-hidden border-b-[1.5px] border-ink transition-colors group-hover:border-orange", project.slides ? "bg-ink" : "bg-chalk"]}>
    {/* Plusieurs visuels : ils défilent automatiquement, affichés en entier */}
    {
      project.slides ? (
        <PosterRotator
          slides={project.slides}
          label={`Visuels du projet ${project.title}`}
          sizes="(min-width: 1024px) 25vw, 60vw"
          class="absolute inset-0"
          imgClass="object-contain pt-4 pb-8"
        />
      ) : (
        <Image
          src={project.image}
          alt={project.alt}
          inferSize={typeof project.image === "string"}
          widths={[480, 800, 1200]}
          sizes="(min-width: 1024px) 50vw, 100vw"
          class:list={["absolute inset-0 size-full object-cover", project.slug === "montbeliard" && "scale-[1.04]"]}
        />
      )
    }
  </div>

  <div class="flex flex-1 flex-col p-5 md:p-6">
    <p class="text-sm text-slate">{projectMeta(project)}</p>
    <h3 class="mt-2 font-varsity text-[clamp(1.6rem,4vw,2.25rem)] leading-none uppercase group-hover:text-orange">
      {project.title}
    </h3>
    <p class="mt-3 leading-relaxed">{project.intro}</p>
    {
      showRole && (
        <p class="mt-4 text-sm leading-relaxed text-slate">
          <span class="font-semibold text-ink">Mon rôle :</span> {project.role}
        </p>
      )
    }
    <span class="mt-auto pt-5 font-semibold underline decoration-2 underline-offset-4 group-hover:text-orange">
      Voir le projet
    </span>
  </div>
</a>
