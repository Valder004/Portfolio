---
// Image cliquable qui s'ouvre en grand (voir src/scripts/lightbox.js).
import { Image } from "astro:assets";

const { image, alt, title, class: className = "", number, sizes = "(max-width: 820px) 100vw, 50vw" } = Astro.props;
---

<button
  type="button"
  class={`project-image-trigger ${className}`}
  aria-label={`Agrandir le visuel de ${title}`}
  aria-haspopup="dialog"
  data-lightbox-src={image.src}
  data-lightbox-alt={alt}
  data-lightbox-title={title}
>
  <Image src={image} alt={alt} widths={[480, 800, 1200, 1600]} sizes={sizes} />
  {number && <span>{number}</span>}
  <small class="image-enlarge-label">Agrandir le visuel <b aria-hidden="true">⤢</b></small>
</button>
