---
// Image cliquable qui s'ouvre en grand (voir src/scripts/lightbox.js).
import { Image } from "astro:assets";

const { image, alt, title, class: className = "", sizes = "(min-width: 768px) 50vw, 100vw", hint = true } = Astro.props;
---

<figure class:list={["min-w-0", className]}>
  <button
    type="button"
    class="block w-full cursor-zoom-in border-[1.5px] border-ink bg-chalk p-0 transition-colors hover:border-orange"
    aria-label={`Agrandir l'image : ${title}`}
    aria-haspopup="dialog"
    data-lightbox-src={typeof image === "string" ? image : image.src}
    data-lightbox-alt={alt}
    data-lightbox-title={title}
  >
    <Image src={image} alt={alt} inferSize={typeof image === "string"} widths={[480, 800, 1200, 1600]} sizes={sizes} class="block h-auto w-full" />
  </button>
  {hint && <figcaption class="mt-2 text-sm text-slate">Cliquez sur l'image pour l'agrandir.</figcaption>}
</figure>
