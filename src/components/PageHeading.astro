---
// En-tête des pages intérieures : grand titre « maillot » + courte introduction.
const { title, intro } = Astro.props;
---

<header class="max-w-4xl">
  <h1 class="font-varsity text-[clamp(2.75rem,10vw,5.5rem)] leading-[0.95] uppercase">{title}</h1>
  {intro && <p class="mt-6 max-w-2xl text-lg leading-relaxed text-slate md:text-xl">{intro}</p>}
</header>
