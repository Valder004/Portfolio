---
import Layout from "../layouts/Layout.astro";
import PageHeading from "../components/PageHeading.astro";
import ContactBanner from "../components/ContactBanner.astro";
import Portrait from "../components/Portrait.astro";
import { expertises } from "../data/projects.js";

const path = [
  {
    date: "2025-2028",
    status: "En cours",
    degree: "BUT MMI",
    subtitle: "Métiers du multimédia et de l'internet",
    text: "Une formation pour concevoir des messages, produire des contenus et les diffuser sur des supports numériques. Je m'oriente vers la communication, en m'appuyant sur les outils créatifs et digitaux.",
    tags: ["Communication", "Création de contenus", "Outils numériques"],
  },
  {
    date: "2022-2025",
    status: "2e année validée",
    degree: "Licence STAPS",
    subtitle: "Sciences et techniques des activités physiques et sportives",
    text: "Ce parcours nourrit ma compréhension des pratiques sportives, des publics et des organisations. Une base que je souhaite mobiliser pour communiquer dans le sport.",
    tags: ["Culture sportive", "Publics", "Organisations"],
  },
];

const container = "mx-auto max-w-7xl px-5 md:px-8";
const h2 = "font-varsity text-[clamp(1.75rem,4.5vw,2.75rem)] leading-[1.05] uppercase";
---

<Layout title="À propos" description="Valentin Deroo, étudiant en BUT MMI après une L2 STAPS, orienté communication sportive.">
  <div class:list={[container, "pt-12 pb-16 md:pt-16 md:pb-24"]}>
    <PageHeading title="À propos" intro="Étudiant en MMI après une L2 STAPS, je me spécialise dans la communication sportive." />

    <!-- Présentation -->
    <section class="mt-12 grid items-start gap-10 md:grid-cols-[0.8fr_1.2fr] md:gap-16">
      <Portrait eager />
      <div class="max-w-2xl">
        <p class="text-xl leading-relaxed md:text-2xl">
          Je suis Valentin. Je m'oriente vers la communication sportive pour faire vivre
          les histoires des clubs, des marques et des événements.
        </p>
        <p class="mt-6 text-lg leading-relaxed">
          Mon parcours en STAPS nourrit ma compréhension du sport et de ses publics. En MMI,
          je développe mes compétences en stratégie, création de contenus et communication digitale.
        </p>
        <p class="mt-4 text-lg leading-relaxed text-slate">
          Le design et le développement sont des compétences complémentaires : je les mobilise
          pour créer des supports utiles, au service d'un message et d'un objectif de communication.
        </p>
      </div>
    </section>
  </div>

  <!-- Parcours -->
  <section class="border-y-[1.5px] border-ink bg-chalk py-16 md:py-24" aria-labelledby="path-title">
    <div class={container}>
      <h2 id="path-title" class={h2}>Mon parcours</h2>
      <ol class="mt-10 space-y-6">
        {
          path.map((step) => (
            <li class="grid gap-4 border-[1.5px] border-ink bg-white p-6 md:grid-cols-[10rem_1fr] md:gap-10 md:p-8">
              <div>
                <p class="font-varsity text-2xl">{step.date}</p>
                <p class="mt-1 font-semibold text-orange">{step.status}</p>
              </div>
              <div>
                <h3 class="text-2xl font-bold">{step.degree}</h3>
                <p class="mt-1 text-slate">{step.subtitle}</p>
                <p class="mt-4 max-w-2xl leading-relaxed">{step.text}</p>
                <ul class="mt-4 flex flex-wrap gap-2">
                  {step.tags.map((tag) => <li class="border-[1.5px] border-ink px-3 py-1 text-sm font-semibold">{tag}</li>)}
                </ul>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- Savoir-faire -->
  <section class:list={[container, "py-16 md:py-24"]} aria-labelledby="skills-title">
    <h2 id="skills-title" class={h2}>Savoir-faire</h2>
    <div class="mt-10 grid gap-6 sm:grid-cols-2">
      {
        expertises.map(([title, text]) => (
          <article class="border-[1.5px] border-ink bg-chalk p-6 md:p-8">
            <h3 class="font-varsity text-[clamp(1.4rem,3vw,1.9rem)] leading-tight text-orange uppercase">{title}</h3>
            <p class="mt-3 text-lg leading-relaxed">{text}.</p>
          </article>
        ))
      }
    </div>
  </section>

  <ContactBanner title="Envie de construire la suite ensemble ?" />
</Layout>
