---
import Layout from "../layouts/Layout.astro";
import PageHeading from "../components/PageHeading.astro";
import { site } from "../data/site.js";

const inputClass =
  "mt-2 block w-full border-[1.5px] border-ink bg-white px-4 py-3 text-lg text-ink placeholder:text-slate/70 focus-visible:border-orange focus-visible:outline-none";
---

<Layout title="Contact" description="Une alternance, un stage ou un projet ? Contactez Valentin Deroo.">
  <div class="mx-auto max-w-7xl px-5 pt-12 pb-16 md:px-8 md:pt-16 md:pb-24">
    <PageHeading title="Contact" intro="Une alternance, un stage ou un projet de communication ? Écrivez-moi, je réponds rapidement." />

    <div class="mt-12 grid gap-12 md:grid-cols-[0.8fr_1.2fr] md:gap-16">
      <section aria-labelledby="direct-title">
        <h2 id="direct-title" class="text-xl font-bold">En direct</h2>
        <ul class="mt-4 space-y-3 text-lg">
          <li>
            <a href={`mailto:${site.email}`} class="font-semibold wrap-anywhere underline decoration-2 underline-offset-4 hover:text-orange">{site.email}</a>
          </li>
          <li>
            <a href={site.phone.href} class="font-semibold underline decoration-2 underline-offset-4 hover:text-orange">{site.phone.display}</a>
          </li>
        </ul>
        <p class="mt-8 inline-flex items-center gap-2 border-[1.5px] border-ink px-3 py-1.5 font-semibold">
          <span class="size-2.5 rounded-full bg-[#2f9e44]" aria-hidden="true"></span>
          Disponible pour une alternance
        </p>
      </section>

      <form data-contact-form data-email={site.email} class="border-[1.5px] border-ink bg-chalk p-5 md:p-8" aria-labelledby="form-title">
        <h2 id="form-title" class="font-varsity text-[clamp(1.75rem,4.5vw,2.75rem)] leading-[1.05] uppercase">Envoyer un message</h2>
        <div class="mt-6 grid gap-5 sm:grid-cols-2">
          <label class="block font-semibold">
            Nom
            <input name="name" required autocomplete="name" class={inputClass} />
          </label>
          <label class="block font-semibold">
            Email
            <input name="email" type="email" required autocomplete="email" class={inputClass} />
          </label>
        </div>
        <label class="mt-5 block font-semibold">
          Message
          <textarea name="message" required rows="6" placeholder="Présentez votre projet en quelques lignes" class:list={[inputClass, "resize-y"]}></textarea>
        </label>
        <button
          type="submit"
          class="mt-6 inline-flex min-h-12 cursor-pointer items-center border-[1.5px] border-ink bg-ink px-6 py-3 text-base font-semibold text-white transition-colors hover:border-orange hover:bg-orange disabled:cursor-wait disabled:opacity-60"
        >
          Envoyer le message
        </button>
        <p class="mt-4 font-semibold" role="status" aria-live="polite" data-form-note hidden></p>
      </form>
    </div>
  </div>
</Layout>

<script>
  import { sendContactMessage } from "../lib/contact.js";

  const form = document.querySelector("[data-contact-form]");
  const note = form?.querySelector("[data-form-note]");
  const button = form?.querySelector("button[type=submit]");

  function showNote(text) {
    note.textContent = text;
    note.hidden = false;
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const data = Object.fromEntries(new FormData(form));

    button.disabled = true;
    try {
      const result = await sendContactMessage(data, form.dataset.email);
      if (result === "mailto") {
        showNote("Votre application email va s'ouvrir pour finaliser l'envoi.");
      } else {
        showNote("Message envoyé. Je vous réponds rapidement.");
        form.reset();
      }
    } catch (error) {
      console.error(error);
      showNote("Le message n'a pas pu être envoyé. Réessayez ou écrivez-moi directement par email.");
    } finally {
      button.disabled = false;
    }
  });
</script>
