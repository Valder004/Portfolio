---
import Layout from "../layouts/Layout.astro";
import PageHeading from "../components/PageHeading.astro";
import SectionLabel from "../components/SectionLabel.astro";
import { site } from "../data/site.js";

const fields = [
  { name: "name", label: "01 — Nom", type: "text", autocomplete: "name", placeholder: "Écrivez votre nom" },
  { name: "email", label: "02 — Email", type: "email", autocomplete: "email", placeholder: "Écrivez votre email" },
];
const fieldClass =
  "w-full resize-y bg-transparent p-0 font-display text-[1.75rem] leading-[1.3] text-ink outline-none placeholder:text-ink/30 focus-visible:outline-none md:text-[clamp(1.5rem,2.4vw,2.2rem)]";
---

<Layout title="Contact" description="Une alternance, un stage ou un projet ? Contactez Valentin Deroo.">
  <div class="px-4 pt-12 pb-16 md:px-8 md:pt-[clamp(3rem,6vw,6rem)] md:pb-[clamp(4rem,8vw,8rem)] xl:px-15">
    <PageHeading
      label="Contact — Disponible"
      title="À vous"
      accent="la balle."
      note="Une alternance, un stage ou un projet ? Écrivez-moi."
    />

    <section class="grid gap-12 pt-12 md:grid-cols-[0.7fr_1.3fr] md:gap-[7vw] md:pt-24">
      <aside class="flex flex-col items-start gap-5">
        <SectionLabel>Coordonnées</SectionLabel>
        {
          [
            { href: `mailto:${site.email}`, text: site.email },
            { href: site.phone.href, text: site.phone.display },
          ].map((link) => (
            <a
              href={link.href}
              class="border-b border-ink pb-1 font-display text-[clamp(1.5rem,7vw,3rem)] wrap-anywhere hover:text-orange md:text-[clamp(1.5rem,3vw,3rem)]"
            >
              {link.text} ↗
            </a>
          ))
        }
        <p class="mt-8 flex items-center gap-3 font-mono text-[0.55rem] uppercase">
          <span class="size-2.5 shrink-0 rounded-full bg-live shadow-[0_0_0_4px_rgb(87_181_66/0.15)]"></span>
          Disponible pour de nouvelles opportunités
        </p>
      </aside>

      <form data-contact-form data-email={site.email} class="border border-ink/20 bg-paper-light p-4 md:p-7">
        {
          fields.map((field) => (
            <label class="block border-b border-ink py-5 focus-within:border-orange">
              <span class="mb-4 block font-mono text-[0.55rem] uppercase">{field.label}</span>
              <input
                name={field.name}
                type={field.type}
                required
                autocomplete={field.autocomplete}
                placeholder={field.placeholder}
                class={fieldClass}
              />
            </label>
          ))
        }
        <label class="block border-b border-ink py-5 focus-within:border-orange">
          <span class="mb-4 block font-mono text-[0.55rem] uppercase">03 — Message</span>
          <textarea name="message" required rows="5" placeholder="Décrivez votre projet en quelques mots" class={fieldClass}></textarea>
        </label>

        <button
          type="submit"
          class="mt-8 flex w-full cursor-pointer items-center justify-between bg-ink p-5 text-white uppercase transition-colors hover:text-orange disabled:cursor-wait disabled:opacity-60"
        >
          Envoyer le message <span class="text-2xl" aria-hidden="true">↗</span>
        </button>
        <p class="mt-4 text-[0.75rem]" role="status" aria-live="polite" data-form-note hidden></p>
      </form>
    </section>
  </div>
</Layout>

<script>
  import { sendContactMessage } from "../lib/contact.js";

  const form = document.querySelector("[data-contact-form]");
  const note = form?.querySelector("[data-form-note]");
  const button = form?.querySelector("button[type=submit]");

  function showNote(text) {
    note.textContent = text;
    note.hidden = false;
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    const data = Object.fromEntries(new FormData(form));

    button.disabled = true;
    try {
      const result = await sendContactMessage(data, form.dataset.email);
      if (result === "mailto") {
        showNote("Votre application email va s’ouvrir pour finaliser l’envoi.");
      } else {
        showNote("Merci, votre message est bien envoyé. Je vous réponds rapidement !");
        form.reset();
      }
    } catch (error) {
      console.error(error);
      showNote("Oups, l’envoi a échoué. Écrivez-moi directement par email.");
    } finally {
      button.disabled = false;
    }
  });
</script>
