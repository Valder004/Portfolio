---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import PageHeading from "../../components/PageHeading.astro";
import { getProjects, cacheProjectsPage } from "../../lib/projects.js";

export const prerender = false;
cacheProjectsPage(Astro);

const projects = await getProjects();
---

<Layout title="Projets" description="Les projets de Valentin Deroo : campagnes, identités visuelles, UX/UI et stratégie de communication.">
  <div class="mx-auto max-w-7xl px-5 pt-12 pb-16 md:px-8 md:pt-16 md:pb-24">
    <PageHeading
      title="Projets"
      intro="Campagnes, identités visuelles et sites réalisés pendant mes études. Pour chacun, j'explique le public visé, le message et mes choix."
    />

    <div class="mt-12 grid gap-6 md:grid-cols-2 md:gap-8">
      {projects.map((project) => <ProjectCard project={project} showRole />)}
    </div>
  </div>
</Layout>
