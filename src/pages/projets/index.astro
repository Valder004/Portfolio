---
import Layout from "../../layouts/Layout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import PageHeading from "../../components/PageHeading.astro";
import SectionLabel from "../../components/SectionLabel.astro";
import { getProjects } from "../../lib/projects.js";

const orderedProjects = await getProjects();
const count = String(orderedProjects.length).padStart(2, "0");
---

<Layout title="Projets" description="Les projets de Valentin Deroo : campagnes, identités visuelles, UX/UI et stratégie de communication.">
  <div class="px-4 pt-12 pb-16 md:px-8 md:pt-[clamp(3rem,6vw,6rem)] md:pb-[clamp(4rem,8vw,8rem)] xl:px-15">
    <PageHeading label={`Index des projets — ${count}`} title="Le travail," accent="en images." compact />

    <SectionLabel class="pt-8">{count} projets / 2025 — 2026</SectionLabel>

    <div class="mt-8 grid gap-5 sm:grid-cols-2 md:gap-[clamp(1.25rem,2.5vw,2.5rem)] xl:grid-cols-4 xl:gap-5">
      {orderedProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</Layout>
