---
import Layout from "../../layouts/Layout.astro";
import ProjectImage from "../../components/ProjectImage.astro";
import PosterRotator from "../../components/PosterRotator.astro";
import Button from "../../components/Button.astro";
import { getProjects, projectMeta, cacheProjectsPage } from "../../lib/projects.js";

// Page générée à la demande : le projet est relu dans PocketBase.
export const prerender = false;

const projects = await getProjects();
const index = projects.findIndex((item) => item.slug === Astro.params.slug);
if (index === -1) return Astro.rewrite("/404");

cacheProjectsPage(Astro);
const project = projects[index];
const nextProject = projects[(index + 1) % projects.length];

const container = "mx-auto max-w-7xl px-5 md:px-8";
const h2 = "font-varsity text-[clamp(1.75rem,4.5vw,2.75rem)] leading-[1.05] uppercase";
---

<Layout title={project.title} description={`${project.title} : ${project.intro}`}>
  <!-- En-tête du projet -->
  <header class:list={[container, "pt-10 pb-12 md:pt-14 md:pb-16"]}>
    <a href="/projets" class="font-semibold underline decoration-2 underline-offset-4 hover:text-orange">Tous les projets</a>
    <h1 class="mt-8 max-w-5xl font-varsity text-[clamp(2rem,8vw,5rem)] leading-[0.95] text-orange uppercase">
      {project.title}
    </h1>
    <p class="mt-4 text-lg font-semibold">{projectMeta(project)}</p>
    <p class="mt-6 max-w-3xl text-xl leading-relaxed md:text-2xl">{project.intro}</p>

    {
      project.websiteUnavailable && (
        <p class="mt-6 max-w-3xl border-l-4 border-orange bg-chalk px-5 py-4 leading-relaxed">
          <strong>Site temporairement hors ligne.</strong> Les captures ci-dessous permettent de découvrir {project.title} en attendant son retour.
        </p>
      )
    }
    {
      project.website && !project.websiteUnavailable && (
        <Button href={project.website} variant="orange" class="mt-8" target="_blank" rel="noopener noreferrer">
          Voir le site (nouvel onglet)
        </Button>
      )
    }
  </header>

  <!-- Visuel + objectif, rôle, livrables -->
  <section class="border-y-[1.5px] border-ink bg-chalk">
    <div class:list={[container, "grid gap-10 py-12 md:grid-cols-[minmax(0,1fr)_minmax(0,1fr)] md:gap-14 md:py-20"]}>
      {
        project.slides ? (
          <PosterRotator
            slides={project.slides}
            label={`Visuels du projet ${project.title}`}
            sizes="(min-width: 768px) 28rem, 100vw"
            class="relative aspect-[4/5] w-full border-[1.5px] border-ink bg-ink md:max-w-md"
          />
        ) : (
          <ProjectImage image={project.image} alt={project.alt} title={project.title} sizes="(min-width: 768px) 50vw, 100vw" class="md:max-w-md" />
        )
      }
      <dl class="space-y-8">
        <div>
          <dt class="text-xl font-bold">Objectif</dt>
          <dd class="mt-2 text-lg leading-relaxed">{project.objective}</dd>
        </div>
        <div>
          <dt class="text-xl font-bold">Mon rôle</dt>
          <dd class="mt-2 text-lg leading-relaxed">{project.role}</dd>
        </div>
        <div>
          <dt class="text-xl font-bold">Livrables</dt>
          <dd class="mt-3">
            <ul class="flex flex-wrap gap-2">
              {project.deliverables.map((item) => <li class="border-[1.5px] border-ink bg-white px-3 py-1 font-semibold">{item}</li>)}
            </ul>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- Contexte -->
  <section class:list={[container, "py-16 md:py-24"]}>
    <div class="max-w-3xl">
      <h2 class={h2}>Le contexte</h2>
      <p class="mt-5 text-lg leading-relaxed">{project.context}</p>
    </div>
    {
      project.galleryGrid && (
        <div class="mt-10">
          <p class="text-sm text-slate">Cliquez sur une affiche pour l'agrandir.</p>
          <div class="mt-4 grid gap-x-6 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
            {project.gallery.map((visual) => (
              <div>
                <ProjectImage image={visual.image} alt={visual.alt} title={`${project.title} : ${visual.title}`} sizes="(min-width: 1024px) 30vw, (min-width: 640px) 50vw, 100vw" hint={false} />
                <h3 class="mt-4 text-xl font-bold">{visual.title}</h3>
                {visual.text && <p class="mt-2 leading-relaxed text-slate">{visual.text}</p>}
              </div>
            ))}
          </div>
        </div>
      )
    }
    {
      !project.galleryGrid && project.gallery?.length > 0 && (
        <div class="mt-10 grid gap-8">
          {project.gallery.map((visual) => (
            <ProjectImage image={visual.image} alt={visual.alt} title={`${project.title} : ${visual.title}`} sizes="(min-width: 1280px) 1200px, 100vw" />
          ))}
        </div>
      )
    }
  </section>

  <!-- Public et message -->
  <section class:list={[container, "grid gap-6 pb-14 md:grid-cols-2 md:pb-20"]}>
    <div class="border-[1.5px] border-ink p-6 md:p-8">
      <h2 class={h2}>Le public</h2>
      <p class="mt-5 text-lg leading-relaxed">{project.audience}</p>
    </div>
    <div class="border-[1.5px] border-ink bg-ink p-6 text-white md:p-8">
      <h2 class={h2}>Le message</h2>
      <p class="mt-5 text-lg leading-relaxed">{project.message}</p>
      <p class="mt-5 border-t border-white/25 pt-5 leading-relaxed text-white/75">{project.approach}</p>
    </div>
  </section>

  <!-- Choix -->
  <section class="bg-chalk py-16 md:py-24" aria-labelledby="choices-title">
    <div class={container}>
      <h2 id="choices-title" class={h2}>Mes choix de communication</h2>
      <div class="mt-10 grid gap-8 md:grid-cols-3">
        {
          project.choices.map((choice) => (
            <div class="border-t-4 border-orange pt-5">
              <h3 class="text-xl font-bold">{choice.title}</h3>
              <p class="mt-3 leading-relaxed">{choice.text}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Résultat -->
  <section class:list={[container, "grid gap-10 py-16 md:grid-cols-2 md:gap-14 md:py-24"]}>
    <div>
      <h2 class={h2}>Le résultat</h2>
      <p class="mt-5 text-lg leading-relaxed">{project.result}</p>
    </div>
    <div>
      <h2 class={h2}>Ce que ce projet montre</h2>
      <p class="mt-5 text-lg leading-relaxed">{project.perspective}</p>
    </div>
  </section>

  <!-- Projet suivant -->
  <a href={`/projets/${nextProject.slug}`} class="group block bg-orange text-white">
    <div class:list={[container, "py-12 md:py-16"]}>
      <span class="text-lg font-semibold">Projet suivant</span>
      <span class="mt-2 block font-varsity text-[clamp(2rem,8vw,4.5rem)] leading-none uppercase underline decoration-transparent decoration-4 underline-offset-8 transition-colors group-hover:decoration-white">
        {nextProject.title}
      </span>
    </div>
  </a>
</Layout>
