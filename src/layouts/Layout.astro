---
// Gabarit commun à toutes les pages : <head>, en-tête, menu, pied de page.
import "@fontsource/barlow-condensed/400.css";
import "@fontsource/barlow-condensed/500.css";
import "@fontsource/inter/400.css";
import "@fontsource/jetbrains-mono/400.css";
import "../styles/global.css";
import { site, navigation } from "../data/site.js";
import Logo from "../components/Logo.astro";

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} — ${site.name}` : site.title;
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const isActive = (href) =>
  href === "/" ? pathname === "/" : pathname === href || pathname.startsWith(`${href}/`);
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#f1efe6" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>

  <body class="font-sans">
    <div class="min-h-dvh overflow-x-clip">
      <!-- En-tête -->
      <header
        class="sticky top-0 z-30 flex min-h-18 items-center justify-between gap-4 border-b border-ink/20 bg-paper px-4 md:min-h-22 md:px-8 xl:px-15"
      >
        <div class="flex items-center gap-4">
          <a href="/" class="transition-transform duration-200 hover:-rotate-3" aria-label={`Accueil ${site.name}`}>
            <Logo variant="light" class="w-10 md:w-12" />
          </a>
          <p class="text-[0.8rem] leading-normal text-ink/70">{site.tagline}</p>
        </div>

        <!-- Bouton du menu (mobile et tablette uniquement) -->
        <button
          type="button"
          class="group relative z-40 grid cursor-pointer grid-cols-[1.3rem_auto] items-center gap-x-2.5 gap-y-1 border border-ink px-3 py-2.5 font-mono text-[0.56rem] uppercase aria-expanded:bg-ink aria-expanded:text-paper md:hidden"
          aria-expanded="false"
          aria-controls="main-navigation"
          aria-label="Ouvrir le menu"
          data-menu-toggle
        >
          <span
            class="col-start-1 row-start-1 h-px w-[1.3rem] bg-current transition-transform duration-200 group-aria-expanded:translate-y-[2px] group-aria-expanded:rotate-45"
          ></span>
          <span
            class="col-start-1 row-start-2 h-px w-[1.3rem] bg-current transition-transform duration-200 group-aria-expanded:-translate-y-[2px] group-aria-expanded:-rotate-45"
          ></span>
          <span class="col-start-2 row-span-2 row-start-1" data-menu-label>Menu</span>
        </button>

        <!-- Navigation : panneau plein écran sur mobile, barre horizontale à partir de md -->
        <nav
          id="main-navigation"
          aria-label="Navigation principale"
          data-menu
          class="invisible fixed inset-x-0 top-18 bottom-0 z-30 flex -translate-y-4 flex-col overflow-y-auto bg-paper px-4 pt-6 pb-12 opacity-0 transition duration-200 data-open:visible data-open:translate-y-0 data-open:opacity-100 sm:px-8 md:visible md:static md:translate-y-0 md:flex-row md:items-center md:gap-1.5 md:overflow-visible md:bg-transparent md:p-0 md:opacity-100 md:transition-none"
        >
          <p class="mb-8 font-mono text-[0.6rem] uppercase md:hidden">Portfolio / {site.tagline}</p>

          {
            navigation.map(({ href, label }, index) => {
              const active = isActive(href);
              const isContact = index === navigation.length - 1;
              return (
                <a
                  href={href}
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    // Mobile : grands liens empilés
                    "grid grid-cols-[2rem_1fr_auto] items-center gap-4 border-b border-ink/35 py-3 font-display text-[clamp(2.75rem,13vw,4.5rem)] leading-[0.9] font-medium tracking-[-0.035em] hover:text-orange",
                    // À partir de md : barre horizontale
                    "md:flex md:min-h-11 md:gap-2 md:border-b-2 md:px-4 md:py-3 md:font-sans md:text-[0.7rem] md:leading-normal md:font-normal md:tracking-[0.06em] md:uppercase md:transition-colors",
                    active && "text-orange md:text-ink",
                    // Une seule couleur de bordure par cas, pour éviter les conflits de classes
                    isContact
                      ? "md:ml-2.5 md:border md:border-ink md:bg-orange md:hover:bg-ink md:hover:text-paper"
                      : active
                        ? "md:border-orange md:hover:bg-ink/5"
                        : "md:border-transparent md:hover:border-orange md:hover:bg-ink/5 md:hover:text-ink",
                  ]}
                >
                  <span class="self-start pt-1.5 font-mono text-[0.55rem] tracking-normal md:self-auto md:pt-0 md:text-[0.5rem] md:opacity-50">
                    0{index + 1}
                  </span>
                  {label}
                  {active && (
                    <span class="justify-self-end font-sans text-[2rem] md:hidden" aria-hidden="true">
                      ↗
                    </span>
                  )}
                </a>
              );
            })
          }

          <p class="mt-auto pt-8 text-[0.8rem] leading-[1.7] md:hidden">
            Un club, une marque, un événement ?<br /><span class="text-orange">Faisons équipe.</span>
          </p>
        </nav>
      </header>

      <main>
        <slot />
      </main>

      <!-- Pied de page -->
      <footer
        class="grid items-end gap-8 bg-ink px-4 py-14 text-[0.78rem] text-paper/80 md:grid-cols-[minmax(0,1fr)_auto_auto] md:px-8 xl:px-15"
      >
        <div class="flex items-center gap-5">
          <Logo variant="dark" class="w-16 shrink-0 md:w-20" />
          <div class="space-y-1.5">
            <p class="font-display text-[1.8rem] font-medium text-paper uppercase">{site.name}</p>
            <p>Communication sportive · Contenus · Événementiel</p>
          </div>
        </div>
        <div class="flex flex-wrap gap-3">
          {
            [
              {
                href: `mailto:${site.email}`,
                label: `Envoyer un email à ${site.name}`,
                title: "Email",
                external: false,
              },
              { href: site.socials.linkedin, label: "LinkedIn (nouvel onglet)", title: "LinkedIn", external: true },
              { href: site.socials.instagram, label: "Instagram (nouvel onglet)", title: "Instagram", external: true },
            ].map((link) => (
              <a
                href={link.href}
                aria-label={link.label}
                title={link.title}
                target={link.external ? "_blank" : undefined}
                rel={link.external ? "noreferrer" : undefined}
                class="grid size-11 place-items-center border border-paper/30 text-paper transition-colors hover:border-orange-soft hover:bg-paper/5 hover:text-orange-soft"
              >
                {link.title === "Email" && (
                  <svg class="size-[22px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="14" rx="2" />
                    <path d="m3 6 9 7 9-7" />
                  </svg>
                )}
                {link.title === "LinkedIn" && (
                  <svg class="size-[22px]" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M5.4 7.4a2 2 0 1 0 0-4 2 2 0 0 0 0 4ZM3.7 9h3.4v11H3.7V9Zm5.5 0h3.3v1.5h.1A3.6 3.6 0 0 1 15.9 8.7c3.5 0 4.1 2.3 4.1 5.3v6h-3.4v-5.3c0-1.3 0-3-1.8-3s-2.1 1.4-2.1 2.9V20H9.2V9Z" />
                  </svg>
                )}
                {link.title === "Instagram" && (
                  <svg class="size-[22px]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
                    <rect x="3" y="3" width="18" height="18" rx="5" />
                    <circle cx="12" cy="12" r="4" />
                    <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
                  </svg>
                )}
              </a>
            ))
          }
        </div>
        <p class="md:justify-self-end">© {new Date().getFullYear()} — France</p>
      </footer>
    </div>

    <script src="../scripts/menu.js"></script>
    <script src="../scripts/lightbox.js"></script>
  </body>
</html>
