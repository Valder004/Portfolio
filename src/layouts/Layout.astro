---
// Gabarit commun à toutes les pages : <head>, en-tête, menu, pied de page.
import "../styles/global.css";
import { site, navigation } from "../data/site.js";
import Logo from "../components/Logo.astro";
import Stripes from "../components/Stripes.astro";

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.title;
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const isActive = (href) =>
  href === "/" ? pathname === "/" : pathname === href || pathname.startsWith(`${href}/`);

// Le lien Contact est affiché comme un bouton à part
const links = navigation.filter((item) => item.href !== "/contact");
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&family=Graduate&display=swap"
    />
  </head>

  <body class="font-sans">
    <div class="flex min-h-dvh flex-col overflow-x-clip">
      <!-- En-tête -->
      <header class="sticky top-0 z-30 border-b-[1.5px] border-ink bg-white">
        <div class="mx-auto flex h-18 max-w-7xl items-center justify-between gap-4 px-5 md:h-20 md:px-8">
          <a href="/" class="flex items-center gap-3" aria-label={`Accueil, ${site.name}`}>
            <Logo variant="light" class="w-10 md:w-11" />
            <span class="text-sm leading-tight font-semibold">{site.tagline}</span>
          </a>

          <!-- Navigation ordinateur -->
          <nav aria-label="Navigation principale" class="hidden items-center gap-1 md:flex">
            {
              links.map(({ href, label }) => (
                <a
                  href={href}
                  aria-current={isActive(href) ? "page" : undefined}
                  class:list={[
                    "border-b-[3px] px-3 py-2 font-semibold transition-colors hover:border-orange",
                    isActive(href) ? "border-orange" : "border-transparent",
                  ]}
                >
                  {label}
                </a>
              ))
            }
            <a
              href="/contact"
              aria-current={isActive("/contact") ? "page" : undefined}
              class="ml-3 border-2 border-orange bg-orange px-5 py-2 font-semibold text-white transition-colors hover:border-ink hover:bg-ink"
            >
              Contact
            </a>
          </nav>

          <!-- Bouton du menu mobile -->
          <button
            type="button"
            class="flex cursor-pointer items-center gap-2 border-[1.5px] border-ink px-3 py-2 font-semibold aria-expanded:bg-ink aria-expanded:text-white md:hidden"
            aria-expanded="false"
            aria-controls="mobile-navigation"
            data-menu-toggle
          >
            <svg class="size-5" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M2 6h16M2 14h16"></path>
            </svg>
            <span data-menu-label>Menu</span>
          </button>
        </div>

        <!-- Menu mobile -->
        <nav
          id="mobile-navigation"
          aria-label="Navigation principale"
          data-menu
          class="invisible fixed inset-x-0 top-18 bottom-0 z-30 flex flex-col overflow-y-auto bg-white px-5 pt-4 pb-10 opacity-0 transition-opacity duration-150 data-open:visible data-open:opacity-100 md:hidden"
        >
          {
            navigation.map(({ href, label }) => (
              <a
                href={href}
                aria-current={isActive(href) ? "page" : undefined}
                class:list={[
                  "border-b-[1.5px] border-ink py-4 font-varsity text-4xl uppercase",
                  isActive(href) && "text-orange",
                ]}
              >
                {label}
              </a>
            ))
          }
          <p class="mt-auto pt-10 text-slate">
            Un club, une marque, un événement ? Écrivez-moi à
            <a href={`mailto:${site.email}`} class="font-semibold text-ink underline underline-offset-4">{site.email}</a>.
          </p>
        </nav>
      </header>

      <main class="flex-1">
        <slot />
      </main>

      <Stripes />

      <!-- Pied de page -->
      <footer class="bg-ink text-white">
        <div class="mx-auto grid max-w-7xl gap-10 px-5 py-14 md:grid-cols-[auto_1fr_auto] md:items-center md:px-8">
          <Logo variant="dark" class="w-16" />
          <div>
            <p class="font-varsity text-2xl uppercase">{site.name}</p>
            <p class="mt-1 text-white/70">Communication sportive, contenus et événementiel</p>
          </div>
          <ul class="flex flex-wrap gap-x-6 gap-y-3 font-semibold">
            <li>
              <a href={site.socials.linkedin} target="_blank" rel="noreferrer" class="underline-offset-4 hover:text-orange hover:underline">
                LinkedIn
              </a>
            </li>
            <li>
              <a href={site.socials.instagram} target="_blank" rel="noreferrer" class="underline-offset-4 hover:text-orange hover:underline">
                Instagram
              </a>
            </li>
          </ul>
        </div>
        <div class="border-t border-white/15">
          <p class="mx-auto max-w-7xl px-5 py-5 text-sm text-white/60 md:px-8">© {new Date().getFullYear()} {site.name}</p>
        </div>
      </footer>
    </div>

    <script src="../scripts/menu.js"></script>
    <script src="../scripts/lightbox.js"></script>
  </body>
</html>
